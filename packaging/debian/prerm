#!/bin/sh
# cliprust prerm.
#
# Stop the daemon and drop the Super+V binding before the binary is removed, so
# the shortcut does not linger pointing at a missing executable. Best-effort:
# a failure here must never block the removal.

cleanup_for_invoking_user() {
    user="${SUDO_USER:-}"
    if [ -z "$user" ] && [ -n "${PKEXEC_UID:-}" ]; then
        user="$(getent passwd "$PKEXEC_UID" | cut -d: -f1)"
    fi
    if [ -z "$user" ] || [ "$user" = "root" ]; then
        return 0
    fi
    command -v runuser >/dev/null 2>&1 || return 0

    uid="$(id -u "$user" 2>/dev/null)" || return 0
    home="$(getent passwd "$user" | cut -d: -f6)"
    [ -S "/run/user/$uid/bus" ] || return 0

    runuser -u "$user" -- env \
        HOME="$home" \
        XDG_RUNTIME_DIR="/run/user/$uid" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
        /usr/bin/cliprust --quit >/dev/null 2>&1 || true
    runuser -u "$user" -- env \
        HOME="$home" \
        XDG_RUNTIME_DIR="/run/user/$uid" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
        /usr/bin/cliprust --remove-hotkey /usr/bin/cliprust >/dev/null 2>&1 || true
}

case "${1:-}" in
    remove|purge)
        cleanup_for_invoking_user
        ;;
esac

exit 0
